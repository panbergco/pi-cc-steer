{
  "name": "pi-cc-steer",
  "version": "0.3.6",
  "description": "Claude Code-style steering and background bash for pi: messages typed while the agent works go in together at the next tool boundary, framed for the model; Ctrl+Enter sends now; Ctrl+B moves a running command to the background.",
  "type": "module",
  "license": "MIT",
  "author": "panbergco",
  "keywords": [
    "background",
    "bash",
    "claude-code",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "queue",
    "steering"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panbergco/pi-cc-steer.git"
  },
  "homepage": "https://github.com/panbergco/pi-cc-steer",
  "bugs": {
    "url": "https://github.com/panbergco/pi-cc-steer/issues"
  },
  "files": [
    "index.ts",
    "steer.ts",
    "background/*.ts",
    "background/LICENSE",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "sh -c 'd=$(mktemp -d) && trap \"rm -rf \\\"$d\\\"\" EXIT INT TERM && TMPDIR=\"$d\" node --test \"$@\" steer.test.ts index.test.ts integration.test.ts background/test/*.test.ts' sh"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "typebox": "^1.3.27",
    "@earendil-works/pi-ai": "^0.87.1"
  },
  "pi": {
    "extensions": [
      "index.ts"
    ],
    "image": "https://raw.githubusercontent.com/panbergco/pi-cc-steer/main/assets/1-queued.png"
  }
}
